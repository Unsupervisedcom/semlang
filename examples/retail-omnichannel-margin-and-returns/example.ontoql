// OntoQL sketch for the retail omnichannel margin and returns example.
//
// This version uses the preferred compact syntax:
//
//   - `concept ... is ... from table(...)` declares the semantic concept and its
//     canonical source together.
//   - `field:` declarations create source-backed semantic attributes by name
//     and use Malloy-like `field_name :: Type` annotations.
//   - `role ... when ...` declares role membership from fields on the concept.
//   - `join_one customer?: Customer on customer_id` declares both the
//     analytical join and the semantic participant, with `?` marking
//     optionality.
//   - `validation:` declarations are named Malloy-style predicates where false
//     means an invalid row or model state, not a filtered result.
//   - `query: name is Concept -> { ... }` keeps Malloy's query shape, but the
//     query target is a semantic concept instead of a physical source name.
//   - `maps` is reserved for non-obvious cases; the common case maps by name.
//
// The point is still the same: OntoQL names business concepts like an ontology,
// while retaining Malloy-like sources, joins, measures, and queries.

package retail.omnichannel_margin_returns

// ---------------------------------------------------------------------------
// Semantic Types
// ---------------------------------------------------------------------------
//
// These are not separate ontology concepts with their own rows. They are
// Malloy-like named types over primitive value domains. OntoQL adds semantic
// metadata such as `identifies`, `allowed_values`, and `scale_type`.
//
// `scale_type` follows the measurement-scale vocabulary:
//   nominal  labels with no inherent order
//   ordinal  ordered values without meaningful distances
//   interval ordered values with meaningful distances but no true zero
//   ratio    numeric values with a meaningful zero

type: StoreId is string {
  scale_type: nominal
  identifies: Store
  semantics: "Stable warehouse key for a retail location, ecommerce store, or fulfillment location."
}

type: CustomerId is string {
  scale_type: nominal
  identifies: Customer
  semantics: "Stable key for a shopper the retailer has recognized."
}

type: LoyaltyMemberId is string {
  scale_type: nominal
  identifies_role: LoyaltyCustomer
  semantics: "Program membership identifier; present only for customers in the loyalty role."
}

type: SKUId is string {
  scale_type: nominal
  identifies: ProductSKU
  semantics: "Stable product SKU key, distinct from a sellable SKU number or UPC."
}

type: TransactionId is string {
  scale_type: nominal
  identifies: Sale
  semantics: "Checkout/order event key. A sale can contain multiple sold item lines."
}

type: SaleLineId is string {
  scale_type: nominal
  identifies: SaleLine
  semantics: "Line-grain key for one sold SKU within a sale."
}

type: BusinessDate is date {
  scale_type: interval
  semantics: "Calendar date used for business-effective, balance, and snapshot dates."
}

type: EventTimestamp is timestamp {
  scale_type: interval
  semantics: "Point in time when an event was observed or occurred."
}

type: Dollars is currency {
  scale_type: ratio
  currency: "USD"
  format: currency("USD", 2)
  semantics: "US dollar amount. Amounts can be aggregated only at their declared grain unless a join is fanout-safe."
}

type: UnitCount is number {
  scale_type: ratio
  semantics: "Countable unit quantity with a meaningful zero."
}

type: LineNumber is number {
  scale_type: ordinal
  semantics: "Position of a line within a sale."
}

type: StoreChannelRole is string {
  scale_type: nominal
  allowed_values: ['physical_store', 'ecommerce', 'warehouse']
}

type: ConsentStatus is string {
  scale_type: nominal
  allowed_values: ['granted', 'declined', 'unknown']
}

type: ProductLifecycleStatus is string {
  scale_type: nominal
  allowed_values: ['active', 'discontinued', 'recalled']
}

type: PromotionType is string {
  scale_type: nominal
  allowed_values: ['coupon', 'markdown', 'loyalty_offer', 'free_shipping']
}

type: PromotionFundingSource is string {
  scale_type: nominal
  allowed_values: ['retailer', 'vendor', 'shared']
}

type: SalesChannel is string {
  scale_type: nominal
  allowed_values: ['store', 'web', 'mobile']
}

type: FulfillmentMethod is string {
  scale_type: nominal
  allowed_values: ['cash_and_carry', 'ship_to_home', 'buy_online_pickup_store']
}

type: PromotionAllocationBasis is string {
  scale_type: nominal
  allowed_values: ['line_discount', 'order_proration', 'shipping_credit']
}

type: ReturnChannel is string {
  scale_type: nominal
  allowed_values: ['store', 'mail', 'carrier_pickup']
}

type: ReturnStatus is string {
  scale_type: ordinal
  allowed_values: ['authorized', 'received', 'accepted', 'rejected', 'settled']
}

type: InventorySnapshotSource is string {
  scale_type: nominal
  allowed_values: ['store_count', 'warehouse_management', 'ecommerce_available_to_sell']
}

// ---------------------------------------------------------------------------
// Semantic Sources
// ---------------------------------------------------------------------------

concept Store is kind from table('stores') {
  identity store_id :: StoreId

  field:
    store_code :: string unique
    store_name :: string
    channel_role :: StoreChannelRole
    region :: string
    market :: string
    opened_date :: BusinessDate
    closed_date :: BusinessDate?
    same_store_start_date :: BusinessDate?

  role SameStore when same_store_start_date is not null

  dimension:
    store_label is concat(store_code, ' - ', store_name)
    is_same_store_eligible is this is SameStore

  validation:
    closed_after_opened is {
      description: "A store cannot close before it opens."
      predicate: closed_date is null or closed_date >= opened_date
    }
}

concept Customer is kind from table('customers') {
  // A row exists only when the retailer recognized the shopper. Unrecognized
  // cash purchases have null transactions.customer_id.
  identity customer_id :: CustomerId

  field:
    loyalty_member_id :: LoyaltyMemberId? unique
    household_id :: string?
    payment_card_hash :: string?
    email_hash :: string?
    first_seen_at :: EventTimestamp
    pii_consent_status :: ConsentStatus

  join_many point_balances: LoyaltyPointBalance on loyalty_member_id

  role LoyaltyCustomer when loyalty_member_id is not null

  role PaymentCardRecognizedCustomer
    when loyalty_member_id is null and payment_card_hash is not null

  dimension:
    recognition_method is case
      when this is LoyaltyCustomer then 'loyalty'
      when this is PaymentCardRecognizedCustomer then 'payment_card'
      else 'unknown'
    end

  validation:
    has_recognition_key is {
      description: "A Customer row represents a recognized shopper, so at least one recognition key must be present."
      predicate: loyalty_member_id is not null or payment_card_hash is not null
    }
}

concept LoyaltyPointBalance is situation from table('loyalty_point_balance') {
  // Daily state attached only to loyalty customers.
  identity loyalty_member_id :: LoyaltyMemberId, balance_date :: BusinessDate
  valid_time: balance_date
  observation_time: balance_date

  join_one loyalty_customer: LoyaltyCustomer on loyalty_member_id

  field:
    point_balance :: UnitCount

  measure:
    balance_days is count()
    loyalty_members_with_balance is count(distinct loyalty_member_id)
    point_balance_at_filter is max(point_balance)
    average_point_balance is avg(point_balance)

  view: daily_loyalty_balances is {
    group_by:
      balance_date
      loyalty_member_id
      loyalty_customer.pii_consent_status
    aggregate:
      point_balance_at_filter
  }
}

concept ProductSKU is kind from table('product_skus') {
  identity sku_id :: SKUId

  field:
    sku_number :: string unique
    upc_code :: string?
    created_at :: EventTimestamp
}

concept ProductSKUVersion is phase of ProductSKU from table('product_sku_history') {
  valid_time: period(valid_from, valid_to)

  // `phase of ProductSKU` defines the parent ProductSKU relation. The compiler
  // uses sku_id by convention here; use `parent_key:` later if that inference
  // is not obvious.

  field:
    sku_id :: SKUId
    valid_from :: BusinessDate
    valid_to :: BusinessDate
    product_name :: string
    brand :: string
    department :: string
    category_name :: string
    subcategory_name :: string
    lifecycle_status :: ProductLifecycleStatus
    list_price :: Dollars
    standard_cost :: Dollars

  role ActiveProduct when lifecycle_status = 'active'

  dimension:
    category_path is concat(department, ' / ', category_name, ' / ', subcategory_name)
    category_at_event is category_name

  validation:
    valid_period_is_ordered is {
      description: "A product SKU version must end after it starts."
      predicate: valid_to > valid_from
    }
}

concept Promotion is relator from table('promotions') {
  identity promotion_id :: string
  valid_time: period(starts_at, ends_at)

  field:
    starts_at :: EventTimestamp
    ends_at :: EventTimestamp
    promo_code :: string unique
    promotion_name :: string
    promotion_type :: PromotionType
    funding_source :: PromotionFundingSource

  role VendorFundedPromotion when funding_source = 'vendor'

  dimension:
    is_vendor_funded is this is VendorFundedPromotion

  validation:
    promotion_period_is_ordered is {
      description: "A promotion must end after it starts."
      predicate: ends_at > starts_at
    }
}

concept PromotionAllocation is relator from table('line_item_promotions') {
  identity line_item_id :: SaleLineId, promotion_id :: string

  join_one sale_line: SaleLine on line_item_id

  join_one promotion: Promotion on promotion_id

  field:
    allocation_amount :: Dollars
    allocation_basis :: PromotionAllocationBasis

  measure:
    allocated_discount is sum(allocation_amount)
    vendor_funded_discount is sum(
      case when promotion is VendorFundedPromotion then allocation_amount else 0 end
    )
    promotion_count is count()
}

concept ReturnLine is event from table('return_lines') {
  identity return_line_id :: string
  occurrence_time: returned_at

  join_one original_sale_line: SaleLine on original_line_item_id = line_item_id

  field:
    returned_at :: EventTimestamp
    return_authorization_id :: string
    return_channel :: ReturnChannel
    return_status :: ReturnStatus
    returned_quantity :: UnitCount
    refund_amount :: Dollars
    restocking_fee_amount :: Dollars
    reason_code :: string
    settled_at :: EventTimestamp?

  measure:
    return_authorizations is count(distinct return_authorization_id)
    returned_units is sum(returned_quantity)
    settled_returned_units is sum(case when return_status = 'settled' then returned_quantity else 0 end)
    refund_amount is sum(refund_amount)
    settled_refund_amount is sum(case when return_status = 'settled' then refund_amount else 0 end)
    restocking_fees is sum(restocking_fee_amount)

  view: return_lifecycle is {
    group_by:
      returned_month is returned_at.month
      return_channel
      return_status
      reason_code
    aggregate:
      return_authorizations
      returned_units
      refund_amount
      restocking_fees
  }

  validation:
    settled_returns_have_settlement_time is {
      description: "A settled return must have a settlement timestamp."
      predicate: return_status != 'settled' or settled_at is not null
    }
}

concept Sale is event from table('transactions') {
  // One row per checkout/order event. The customer participant is optional
  // because unrecognized cash buyers do not have a customer_id.
  identity transaction_id :: TransactionId
  occurrence_time: sold_at

  join_one store: Store on store_id

  join_one customer?: Customer on customer_id

  join_one loyalty_points_at_sale?: LoyaltyPointBalance
    on customer.loyalty_member_id = loyalty_points_at_sale.loyalty_member_id
    and sold_at.date = loyalty_points_at_sale.balance_date

  join_many lines: SaleLine on transaction_id

  field:
    sold_at :: EventTimestamp
    store_id :: StoreId
    customer_id :: CustomerId?
    channel :: SalesChannel
    fulfillment_method :: FulfillmentMethod

  dimension:
    sold_date is sold_at.date
    sold_month is sold_at.month
    loyalty_point_balance_at_sale is loyalty_points_at_sale.point_balance

    customer_recognition_method is case
      when customer is null then 'unrecognized_cash'
      when customer is LoyaltyCustomer then 'loyalty'
      when customer is PaymentCardRecognizedCustomer then 'payment_card'
      else 'known_other'
    end

  measure:
    sales is count()
    loyalty_customers is count(distinct case when customer is LoyaltyCustomer then customer.loyalty_member_id end)
    identified_customers is count(distinct customer.customer_id)
    identified_customer_sales is count(case when customer is not null then transaction_id end)
    unrecognized_cash_sales is count(case when customer is null then transaction_id end)
    identified_sales_per_customer is identified_customer_sales / nullif(identified_customers, 0)
    average_loyalty_point_balance_at_sale is avg(loyalty_points_at_sale.point_balance)

  view: loyalty_sale_mix is {
    group_by:
      sold_month
      customer_recognition_method
      customer.pii_consent_status
    aggregate:
      sales
      loyalty_customers
      identified_customer_sales
      average_loyalty_point_balance_at_sale
  }
}

concept SaleLine is situation from table('retail_line_items') {
  // One row per sold SKU line. Merchandise, margin, promotions, and returns
  // live at this grain, while customer/store/date context comes through Sale.
  identity line_item_id :: SaleLineId

  join_one sale: Sale on transaction_id

  join_one sku: ProductSKU on sku_id

  join_one product_at_sale: ProductSKUVersion
    on sku_id = product_at_sale.sku_id
    at sale.sold_at

  join_many promotion_allocations: PromotionAllocation on line_item_id

  join_many returns: ReturnLine on line_item_id = original_line_item_id

  field:
    transaction_id :: TransactionId
    line_number :: LineNumber
    sku_id :: SKUId
    quantity :: UnitCount
    unit_list_price :: Dollars
    gross_sales_amount :: Dollars
    discount_amount :: Dollars
    net_sales_amount :: Dollars
    merchandise_cost_amount :: Dollars
    tax_amount :: Dollars

  dimension:
    sold_date is sale.sold_date
    sold_month is sale.sold_month
    channel is sale.channel
    fulfillment_method is sale.fulfillment_method
    margin_amount is net_sales_amount - merchandise_cost_amount
    customer_recognition_method is sale.customer_recognition_method
    loyalty_point_balance_at_sale is sale.loyalty_point_balance_at_sale
    is_return_window_open is sale.sold_at >= now() - interval('30 day')

  measure:
    line_items is count()
    sales is count(distinct transaction_id)
    units_sold is sum(quantity)
    gross_sales is sum(gross_sales_amount)
    discount_amount is sum(discount_amount)
    net_sales is sum(net_sales_amount)
    merchandise_cost is sum(merchandise_cost_amount)
    merchandising_margin is sum(margin_amount)
    tax_collected is sum(tax_amount)

    promotion_discount is sum(promotion_allocations.allocation_amount)
    vendor_funded_discount is sum(
      case
        when promotion_allocations.promotion is VendorFundedPromotion
        then promotion_allocations.allocation_amount
        else 0
      end
    )

    returned_units is sum(returns.returned_quantity)
    settled_returned_units is sum(
      case when returns.return_status = 'settled' then returns.returned_quantity else 0 end
    )
    refund_amount is sum(returns.refund_amount)
    settled_refund_amount is sum(
      case when returns.return_status = 'settled' then returns.refund_amount else 0 end
    )
    return_rate is returned_units / nullif(units_sold, 0)
    settled_return_rate is settled_returned_units / nullif(units_sold, 0)
    net_after_settled_refunds is net_sales - settled_refund_amount

  view: sales_by_region_category is {
    group_by:
      sold_month
      channel
      sale.store.region
      sale.store.market
      product_at_sale.department
      product_at_sale.category_name
    aggregate:
      sales
      units_sold
      gross_sales
      discount_amount
      net_sales
      merchandising_margin
      settled_refund_amount
      settled_returned_units
      net_after_settled_refunds
  }

  view: loyalty_margin_mix is {
    group_by:
      sold_month
      customer_recognition_method
      sale.customer.pii_consent_status
      product_at_sale.category_name
    aggregate:
      sales
      sale.loyalty_customers
      sale.identified_customer_sales
      sale.average_loyalty_point_balance_at_sale
      net_sales
      merchandising_margin
      refund_amount
  }
}

concept InventoryPosition is situation from table('inventory_snapshots') {
  identity inventory_snapshot_id :: string
  valid_time: snapshot_date
  observation_time: snapshot_date

  join_one store: Store on store_id

  join_one sku: ProductSKU on sku_id

  join_one product_at_snapshot: ProductSKUVersion
    on sku_id = product_at_snapshot.sku_id
    at snapshot_date

  field:
    snapshot_date :: BusinessDate
    on_hand_units :: UnitCount
    on_order_units :: UnitCount
    reserved_units :: UnitCount
    damaged_units :: UnitCount
    snapshot_source :: InventorySnapshotSource

  dimension:
    available_to_sell_units is on_hand_units - reserved_units - damaged_units
    is_negative_on_hand is on_hand_units < 0

  measure:
    snapshot_rows is count()
    on_hand_units_at_filter is max(on_hand_units)
    on_order_units_at_filter is max(on_order_units)
    reserved_units_at_filter is max(reserved_units)
    damaged_units_at_filter is max(damaged_units)
    available_to_sell_at_filter is max(available_to_sell_units)
    negative_on_hand_locations is count(case when is_negative_on_hand then inventory_snapshot_id end)
}

// ---------------------------------------------------------------------------
// Queries
// ---------------------------------------------------------------------------

query: monthly_margin_and_returns is SaleLine -> {
  // Business question:
  //   "Show monthly margin and returns by region and product category."
  //
  // Agent discovery sketch:
  //   mcp.semantic.search_terms({ question })
  //   -> concepts: SaleLine, Sale, ReturnLine, Store, ProductSKUVersion
  //   mcp.catalog.describe_concept_source({ concept: "SaleLine" })
  //   -> source table retail_line_items, joins sale/product_at_sale/returns
  //   mcp.query.validate({ group_by, aggregate })
  //   -> valid; all paths are reachable from SaleLine
  group_by:
    sold_month
    sale.store.region
    product_at_sale.category_name
  aggregate:
    net_sales
    merchandising_margin
    settled_refund_amount
    net_after_settled_refunds
    settled_return_rate
}

query: inventory_exceptions is InventoryPosition -> {
  // Business question:
  //   "Which store/SKU inventory positions look wrong or risky?"
  //
  // Agent discovery sketch:
  //   mcp.semantic.search_terms({ question })
  //   -> concepts: InventoryPosition, Store, ProductSKU, ProductSKUVersion
  //   -> exception predicates: negative on hand, recalled, discontinued
  where:
    is_negative_on_hand
    or product_at_snapshot.lifecycle_status in ('recalled', 'discontinued')
  group_by:
    snapshot_date
    store.store_code
    sku.sku_number
    product_at_snapshot.product_name
    product_at_snapshot.lifecycle_status
  aggregate:
    on_hand_units_at_filter
    damaged_units_at_filter
    available_to_sell_at_filter
}

query: vendor_funded_return_exposure is SaleLine -> {
  // Business question:
  //   "Where are vendor-funded promotions creating returns exposure?"
  //
  // Agent discovery sketch:
  //   mcp.ontology.find_paths({
  //     from: "SaleLine",
  //     to: ["Promotion", "ReturnLine"]
  //   })
  //   -> SaleLine -> PromotionAllocation -> Promotion
  //   -> SaleLine -> ReturnLine
  //   mcp.query.validate(...)
  //   -> warning: promotion allocations are one-to-many, so use declared
  //      fanout-safe measures where needed
  where:
    promotion_allocations.promotion is VendorFundedPromotion
  group_by:
    sold_month
    channel
    sale.store.region
    product_at_sale.department
    product_at_sale.category_name
    promotion_allocations.promotion.promo_code
  aggregate:
    units_sold
    net_sales
    vendor_funded_discount
    merchandising_margin
    returned_units
    settled_refund_amount
    settled_return_rate
}

query: denver_store_customer_count_on_2025_09_15 is Sale -> {
  // Deliberately tricky business question:
  //   "How many customers did the Denver store have on 9/15/2025?"
  //
  // The source observes sales and sometimes links them to a recognized
  // Customer. It does not identify unrecognized cash buyers. So the right answer
  // is not one exact count; it is observed facts plus a bound/estimate.
  //
  // Agent discovery sketch:
  //   mcp.semantic.search_terms({ question })
  //   -> concepts: Sale, Store, Customer
  //   mcp.ontology.describe_concept({ concept: "Sale" })
  //   -> customer?: Customer, so null customer means unrecognized buyer
  //   mcp.catalog.resolve_entity({ concept: "Store", business_name: "Denver store" })
  //   -> store.store_code = 'DEN-01', store_name = "Denver Cherry Creek"
  //   mcp.query.run(...)
  //   -> sales: 7500
  //   -> identified_customer_sales: 4000
  //   -> identified_customers: 3700
  //   -> unrecognized_cash_sales: 3500
  //   mcp.reasoning.derive(...)
  //   -> max_possible_unique_customers = 3700 + 3500 = 7200
  //   -> identified_sales_per_customer = 4000 / 3700 = 1.0811
  //   -> estimated_total_customers_same_repeat_rate =
  //      3700 + (3500 / 1.0811) = 6938
  //
  // Best response:
  //   "Denver Cherry Creek had 7,500 transactions on September 15, 2025.
  //    4,000 of them were linked to 3,700 identified customers. The remaining
  //    3,500 were unrecognized cash purchases. That means there were up to
  //    7,200 unique customers if every cash buyer bought once, or about 6,938
  //    if anonymous buyers repeated at the same rate as identified buyers."
  where:
    sold_date = date '2025-09-15'
    and store.store_code = 'DEN-01'
  aggregate:
    sales
    identified_customer_sales
    identified_customers
    unrecognized_cash_sales
    identified_sales_per_customer

    // V1 rule: `name is expression` inside `aggregate:` creates a query-local
    // generated measure on the temporary query source. The expression may
    // reference visible measures, aggregate functions, or earlier aliases in
    // this same aggregate block. It may not reference raw row-level fields
    // unless they are inside an aggregate function.
    max_possible_unique_customers is
      identified_customers + unrecognized_cash_sales

    // Legal because it references measures that are already visible above.
    estimated_unrecognized_customers_same_repeat_rate is
      unrecognized_cash_sales / nullif(identified_sales_per_customer, 0)

    // Legal because it references an earlier query-local aggregate alias.
    estimated_total_customers_same_repeat_rate is
      identified_customers + estimated_unrecognized_customers_same_repeat_rate
}

query: same_store_category_health is SaleLine -> {
  // Business question:
  //   "How are active categories performing in comparable same-store locations?"
  //
  // Agent discovery sketch:
  //   mcp.ontology.find_paths({
  //     from: "SaleLine",
  //     to: ["SameStore", "ActiveProduct"]
  //   })
  //   -> SaleLine.sale.store plays SameStore
  //   -> SaleLine.product_at_sale plays ActiveProduct
  where:
    sale.store is SameStore
    and product_at_sale is ActiveProduct
  group_by:
    sold_month
    sale.store.region
    sale.store.market
    product_at_sale.department
    product_at_sale.category_name
  aggregate:
    sales
    units_sold
    net_sales
    merchandising_margin
    net_after_settled_refunds
}

// ---------------------------------------------------------------------------
// Compiler Ideas Implied By This Compact Syntax
// ---------------------------------------------------------------------------
//
// A first OntoQL implementation could expand this compact file into verbose
// concept declarations plus Malloy source definitions:
//
//   - `concept X is kind from table('x')` creates both the concept and source.
//   - `field_name :: Type` maps by name to `X.field_name`.
//   - `occurrence_time`, `valid_time`, `observation_time`, and
//     `recorded_time` are explicit temporal axes. Events usually use
//     occurrence_time; situations usually use valid_time and may also declare
//     observation_time for measured state.
//   - `join_one x: VersionedConcept ... at t` expands to a join whose `t`
//     falls within the joined concept's `valid_time`.
//   - `role R when predicate` creates a type-like predicate usable as
//     `thing is R`.
//   - `validation: name is { predicate: ... }` compiles the predicate into an
//     executable data-quality check; false rows are errors.
//   - `format: currency("USD", 2)` is OntoQL metadata; a Malloy emitter can
//     translate it to the target dialect's annotation syntax.
//   - `join_one customer?: Customer on customer_id` creates an optional
//     participant and a Malloy join.
//   - `query: q is Concept -> { ... }` compiles by resolving the semantic
//     concept name to its canonical source.
//   - `aggregate: alias is expression` creates a query-local generated measure.
//     The expression can reference visible measures, aggregate functions, and
//     earlier aggregate aliases. Raw fields are only legal inside aggregate
//     functions, keeping row-grain and aggregate-grain expressions separate.
