source: accounts is table('accounts') extend {
  primary_key: account_id

  dimension:
    account_label is concat(account_name, ' (', segment, ')')
    is_enterprise is segment = 'enterprise'
}

source: workspaces is table('workspaces') extend {
  primary_key: workspace_id

  join_one: account is accounts
    on account_id = account.account_id

  dimension:
    is_production_workspace is workspace_type = 'production'
    is_archived is archived_at is not null
}

source: users is table('users') extend {
  primary_key: user_id

  join_one: account is accounts
    on account_id = account.account_id

  join_one: workspace is workspaces
    on workspace_id = workspace.workspace_id

  dimension:
    is_paid_seat is seat_type = 'paid'
    is_active_user_record is deactivated_at is null
}

source: product_plans is table('product_plans') extend {
  primary_key: plan_id

  dimension:
    plan_label is concat(plan_code, ' / ', plan_family)
}

source: product_features is table('product_features') extend {
  primary_key: feature_key
}

source: subscriptions is table('subscriptions') extend {
  primary_key: subscription_id

  join_one: account is accounts
    on account_id = account.account_id

  join_one: plan is product_plans
    on plan_id = plan.plan_id

  dimension:
    is_active_subscription is subscription_state = 'active'
    cancellation_requested_date is cancellation_requested_at.date
    churn_month is churn_effective_date.month

  measure:
    subscriptions is count()
    active_subscriptions is count() { where: subscription_state = 'active' }
    contracted_arr is sum(contracted_arr)
    contracted_mrr_run_rate is sum(contracted_arr / 12)
    paid_seats is sum(paid_seats)
}

source: contracts is table('contracts') extend {
  primary_key: contract_id

  join_one: account is accounts
    on account_id = account.account_id

  join_one: subscription is subscriptions
    on subscription_id = subscription.subscription_id

  dimension:
    contract_start_month is contract_start_date.month
    contract_end_month is contract_end_date.month
    is_expansion_contract is arr_delta > 0
    is_contraction_contract is arr_delta < 0

  measure:
    contracts is count()
    booking_arr is sum(booking_arr)
    prior_arr is sum(prior_arr)
    expansion_arr_booked is sum(case when arr_delta > 0 then arr_delta else 0 end)
    contraction_arr_booked is sum(case when arr_delta < 0 then abs(arr_delta) else 0 end)
}

source: subscription_periods is table('subscription_periods') extend {
  primary_key: subscription_period_id

  join_one: account is accounts
    on account_id = account.account_id

  join_one: subscription is subscriptions
    on subscription_id = subscription.subscription_id

  join_one: plan is product_plans
    on plan_id = plan.plan_id

  dimension:
    period_month is period_start.month
    is_churn_effective_period is churn_effective_flag
    mrr_run_rate_amount is ending_arr / 12

  measure:
    subscription_period_rows is count()
    ending_arr is sum(ending_arr)
    starting_arr is sum(starting_arr)
    mrr_run_rate is sum(ending_arr / 12)
    paid_seats is sum(paid_seats)
    expansion_arr is sum(case when arr_delta > 0 then arr_delta else 0 end)
    contraction_arr is sum(case when arr_delta < 0 then abs(arr_delta) else 0 end)
    gross_churn_arr is sum(case when churn_effective_flag then prior_arr_amount else 0 end)
    logo_churned_accounts is count(distinct case when churn_effective_flag then account_id end)
    active_subscription_periods is count() { where: period_state = 'active' }

  view: arr_movement_by_period is {
    group_by:
      period_month
      account.segment
      account.region
      plan.plan_family
      period_state
    aggregate:
      starting_arr
      ending_arr
      mrr_run_rate
      expansion_arr
      contraction_arr
      gross_churn_arr
      logo_churned_accounts
      active_subscription_periods
  }
}

source: invoices is table('invoices') extend {
  primary_key: invoice_id

  join_one: account is accounts
    on account_id = account.account_id

  join_one: subscription is subscriptions
    on subscription_id = subscription.subscription_id

  dimension:
    invoice_month is invoice_date.month
    is_paid_invoice is invoice_status = 'paid'

  measure:
    invoices is count()
    invoice_total is sum(invoice_total)
    paid_invoice_total is sum(case when invoice_status = 'paid' then invoice_total else 0 end)
}

source: invoice_lines is table('invoice_lines') extend {
  primary_key: invoice_line_id

  join_one: invoice is invoices
    on invoice_id = invoice.invoice_id

  join_one: account is accounts
    on account_id = account.account_id

  join_one: subscription is subscriptions
    on subscription_id = subscription.subscription_id

  dimension:
    service_start_month is service_period_start.month
    service_end_month is service_period_end.month

  measure:
    invoice_lines is count()
    billed_amount is sum(billed_amount)
    recurring_billed_amount is sum(case when line_type = 'recurring' then billed_amount else 0 end)
    credit_amount is sum(case when line_type = 'credit' then billed_amount else 0 end)
}

source: revenue_recognition is table('revenue_recognition') extend {
  primary_key: revenue_recognition_id

  join_one: invoice_line is invoice_lines
    on invoice_line_id = invoice_line.invoice_line_id

  join_one: account is accounts
    on account_id = account.account_id

  join_one: subscription is subscriptions
    on subscription_id = subscription.subscription_id

  dimension:
    recognized_month is recognition_month.month
    is_recurring_revenue is revenue_category = 'subscription'

  measure:
    revenue_recognition_rows is count()
    recognized_revenue is sum(recognized_revenue_amount)
    recognized_subscription_revenue is sum(case when revenue_category = 'subscription' then recognized_revenue_amount else 0 end)
    recognized_credit_amount is sum(case when revenue_category = 'credit' then recognized_revenue_amount else 0 end)

  view: recognized_revenue_by_month is {
    group_by:
      recognized_month
      account.segment
      account.region
      revenue_category
      accounting_basis
    aggregate:
      recognized_revenue
      recognized_subscription_revenue
      recognized_credit_amount
  }
}

source: entitlement_intervals is table('entitlement_intervals') extend {
  primary_key: entitlement_interval_id

  join_one: plan is product_plans
    on plan_id = plan.plan_id

  join_one: feature is product_features
    on feature_key = feature.feature_key

  dimension:
    is_included_or_metered is entitlement_status in ('included', 'metered')

  measure:
    entitlement_intervals is count()
    enabled_entitlements is count() { where: entitlement_status in ('included', 'metered') }
}

source: user_activity_days is table('user_activity_days') extend {
  primary_key: user_activity_day_id

  join_one: user is users
    on user_id = user.user_id

  join_one: workspace is workspaces
    on workspace_id = workspace.workspace_id

  join_one: account is accounts
    on account_id = account.account_id

  join_one: subscription is subscriptions
    on subscription_id = subscription.subscription_id

  dimension:
    activity_month is activity_date.month
    active_minutes is active_seconds / 60

  measure:
    user_activity_days is count()
    active_users is count(distinct user_id)
    active_workspaces is count(distinct workspace_id)
    active_accounts is count(distinct account_id)
    billable_active_users is count(distinct case when is_billable_seat_activity then user_id end)
    sessions is sum(sessions_count)
    actions is sum(actions_count)
    active_seconds is sum(active_seconds)
    avg_active_seconds_per_user_day is active_seconds / nullif(user_activity_days, 0)

  view: product_activity_by_workspace is {
    group_by:
      activity_month
      account.segment
      account.region
      workspace.workspace_type
    aggregate:
      active_accounts
      active_workspaces
      active_users
      billable_active_users
      sessions
      actions
      active_seconds
      avg_active_seconds_per_user_day
  }
}

source: feature_usage_days is table('feature_usage_days') extend {
  primary_key: feature_usage_day_id

  join_one: user is users
    on user_id = user.user_id

  join_one: workspace is workspaces
    on workspace_id = workspace.workspace_id

  join_one: account is accounts
    on account_id = account.account_id

  join_one: subscription is subscriptions
    on subscription_id = subscription.subscription_id

  join_one: plan is product_plans
    on plan_id = plan.plan_id

  join_one: feature is product_features
    on feature_key = feature.feature_key

  join_one: entitlement_at_activity is entitlement_intervals
    on plan_id = entitlement_at_activity.plan_id
    and feature_key = entitlement_at_activity.feature_key
    and activity_date >= entitlement_at_activity.valid_from
    and activity_date < entitlement_at_activity.valid_to

  dimension:
    activity_month is activity_date.month
    is_entitled_usage is entitlement_at_activity.entitlement_status in ('included', 'metered')
    is_metered_usage is entitlement_at_activity.entitlement_status = 'metered'

  measure:
    feature_usage_days is count()
    feature_events is sum(usage_count)
    units_consumed is sum(units_consumed)
    feature_active_users is count(distinct case when feature_used_flag then user_id end)
    feature_active_workspaces is count(distinct case when feature_used_flag then workspace_id end)
    feature_adoption_accounts is count(distinct case when feature_used_flag then account_id end)
    entitled_feature_events is sum(case when entitlement_at_activity.entitlement_status in ('included', 'metered') then usage_count else 0 end)
    disabled_feature_events is sum(case when entitlement_at_activity.entitlement_status = 'disabled' then usage_count else 0 end)

  view: entitlement_aware_feature_adoption is {
    group_by:
      activity_month
      account.segment
      plan.plan_family
      feature.feature_family
      feature.feature_name
      entitlement_at_activity.entitlement_status
      entitlement_at_activity.enforcement_mode
    aggregate:
      feature_active_users
      feature_active_workspaces
      feature_adoption_accounts
      feature_events
      entitled_feature_events
      disabled_feature_events
      units_consumed
  }
}

source: support_cases is table('support_cases') extend {
  primary_key: support_case_id

  join_one: account is accounts
    on account_id = account.account_id

  join_one: workspace is workspaces
    on workspace_id = workspace.workspace_id

  join_one: subscription is subscriptions
    on subscription_id = subscription.subscription_id

  dimension:
    opened_month is opened_at.month
    first_response_minutes is extract('epoch' from first_response_at - opened_at) / 60
    resolution_minutes is extract('epoch' from resolved_at - opened_at) / 60
    net_resolution_minutes is (extract('epoch' from resolved_at - opened_at) / 60) - sla_paused_minutes

  measure:
    support_cases is count()
    open_cases is count() { where: case_status in ('open', 'pending_customer') }
    urgent_cases is count() { where: priority = 'urgent' }
    avg_first_response_minutes is avg(first_response_minutes)
    avg_net_resolution_minutes is avg(net_resolution_minutes)
    avg_csat_score is avg(csat_score)

  view: support_health is {
    group_by:
      opened_month
      account.segment
      priority
      case_status
      category
    aggregate:
      support_cases
      open_cases
      urgent_cases
      avg_first_response_minutes
      avg_net_resolution_minutes
      avg_csat_score
  }
}

source: incidents is table('incidents') extend {
  primary_key: incident_id

  dimension:
    started_month is started_at.month
    duration_minutes is extract('epoch' from resolved_at - started_at) / 60
    detection_lag_minutes is extract('epoch' from detected_at - started_at) / 60

  measure:
    incidents is count()
    customer_visible_incidents is count() { where: customer_visible }
    avg_detection_lag_minutes is avg(detection_lag_minutes)
    avg_duration_minutes is avg(duration_minutes)
}

source: incident_workspace_impacts is table('incident_workspace_impacts') extend {
  primary_key: incident_impact_id

  join_one: incident is incidents
    on incident_id = incident.incident_id

  join_one: workspace is workspaces
    on workspace_id = workspace.workspace_id

  join_one: account is accounts
    on account_id = account.account_id

  dimension:
    impact_month is impact_start_at.month

  measure:
    impacted_workspace_rows is count()
    impacted_accounts is count(distinct account_id)
    impacted_workspaces is count(distinct workspace_id)
    incident_impact_minutes is sum(impact_minutes)

  view: incident_customer_impact is {
    group_by:
      impact_month
      account.segment
      incident.severity
      incident.product_area
      incident.customer_visible
      impact_type
    aggregate:
      impacted_accounts
      impacted_workspaces
      incident_impact_minutes
  }
}

source: renewals is table('renewals') extend {
  primary_key: renewal_id

  join_one: account is accounts
    on account_id = account.account_id

  join_one: subscription is subscriptions
    on subscription_id = subscription.subscription_id

  join_one: current_contract is contracts
    on current_contract_id = current_contract.contract_id

  dimension:
    renewal_due_month is renewal_due_date.month
    is_closed_won is renewal_stage = 'closed_won'
    is_closed_lost is renewal_stage = 'closed_lost'

  measure:
    renewals is count()
    renewal_arr is sum(renewal_arr)
    expansion_arr_forecast is sum(expansion_arr_forecast)
    contraction_arr_risk is sum(contraction_arr_risk)
    closed_won_arr is sum(case when renewal_stage = 'closed_won' then renewal_arr + expansion_arr_forecast else 0 end)
    closed_lost_arr is sum(case when renewal_stage = 'closed_lost' then renewal_arr else 0 end)

  view: renewal_pipeline is {
    group_by:
      renewal_due_month
      account.segment
      forecast_category
      renewal_stage
      churn_risk_reason
    aggregate:
      renewals
      renewal_arr
      expansion_arr_forecast
      contraction_arr_risk
      closed_won_arr
      closed_lost_arr
  }
}

query: finance_arr_movement is subscription_periods -> {
  group_by:
    period_month
    account.segment
    account.region
    plan.plan_family
    period_state
  aggregate:
    starting_arr
    ending_arr
    mrr_run_rate
    expansion_arr
    contraction_arr
    gross_churn_arr
    logo_churned_accounts
}

query: recognized_revenue_trend is revenue_recognition -> {
  group_by:
    recognized_month
    account.segment
    account.region
    revenue_category
    accounting_basis
  aggregate:
    recognized_revenue
    recognized_subscription_revenue
    recognized_credit_amount
}

query: entitlement_aware_usage is feature_usage_days -> {
  group_by:
    activity_month
    account.segment
    plan.plan_family
    feature.feature_family
    feature.feature_name
    entitlement_at_activity.entitlement_status
  aggregate:
    feature_active_users
    feature_active_workspaces
    feature_adoption_accounts
    feature_events
    entitled_feature_events
    disabled_feature_events
}

query: renewal_risk_summary is renewals -> {
  group_by:
    renewal_due_month
    account.segment
    forecast_category
    renewal_stage
    churn_risk_reason
  aggregate:
    renewals
    renewal_arr
    expansion_arr_forecast
    contraction_arr_risk
    closed_won_arr
    closed_lost_arr
}
