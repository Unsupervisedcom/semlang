#!/usr/bin/env sh

old_ref="$1"
new_ref="$2"

if [ "$old_ref" = "0000000000000000000000000000000000000000" ]; then
  exit 0
fi

if git diff --name-only "$old_ref" "$new_ref" -- package-lock.json | grep -q '^package-lock.json$'; then
  echo "package-lock.json changed; running npm install"
  npm install
fi
